# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# ---- Admin dashboard (/admin) ----
# PostgreSQL connection. On Vercel, connecting Neon (Storage tab) adds this automatically.
DATABASE_URL=
# Password for /admin (12+ characters recommended). Required to use the admin.
ADMIN_PASSWORD=
# Optional extra secret for signing admin sessions.
ADMIN_SESSION_SECRET=

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://hifivebyjia.in

# Business WhatsApp number for orders, international format, digits only.
# Example: 919876543210. Use a business number — never a child's personal number.
# (Can also be set in Admin → Settings, which takes priority.)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: also forward form submissions (reviews, notify-me, contact, order
# requests) as JSON — e.g. to a Google Sheet via Apps Script, Formspree or Make.
# They are always saved in the database / admin when DATABASE_URL is set.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Analytics (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Phase 2 (not used yet) ----
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
