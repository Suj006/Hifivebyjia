# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# Never commit real secrets.

# Public site URL (used for canonical URLs, sitemap and Open Graph)
NEXT_PUBLIC_SITE_URL=https://hifivebyjia.in

# Business WhatsApp number for orders, international format, digits only.
# Example: 919876543210. Use a business number — never a child's personal number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: where form submissions (reviews, notify-me, contact, order requests)
# are forwarded as JSON. Works with Google Apps Script, Formspree, Make, Zapier, etc.
# Server-only — not exposed to the browser.
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=

# Analytics (leave empty to disable)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---- Phase 2 (not used yet) ----
